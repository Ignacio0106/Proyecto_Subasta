@model IEnumerable<Subasta.Aplication.DTOs.SubastaDTO>

@{
    ViewData["Title"] = "Index";
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <h1 class="mb-4">Subastas</h1>

    <div class="d-flex gap-2">

        <button id="btnTodas" class="btn btn-outline-dark">Todas</button>
        <button id="btnActivas" class="btn btn-outline-success">Activas</button>
        <button id="btnFinalizadas" class="btn btn-outline-danger">Finalizadas</button>

    </div>

    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-circle me-1"></i>
        Nueva subasta
    </a>
</div>

<div class="container">
    <div class="row g-4" id="contenedorSubastas">
@*         <script>
            const subastas = @Html.Raw(Json.Serialize(Model));
        </script> *@

        @foreach (var item in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">

                    <div class="bg-light rounded-top d-flex justify-content-center align-items-center"
                         style="height: 220px; overflow: hidden;">

                        @if (item.ImagenPrincipal != null && item.ImagenPrincipal.Length > 0)
                        {
                            <img class="img-fluid"
                                 style="max-height: 100%; max-width: 100%; object-fit: contain;"
                                 src="data:image/jpeg;base64,@Convert.ToBase64String(item.ImagenPrincipal)"
                                 alt="Imagen de @item.ImagenPrincipal"
                                 loading="lazy" />
                        }
                        else
                        {
                            <div class="d-flex justify-content-center align-items-center h-100 text-muted">
                                <i class="bi bi-image fs-1"></i>
                                <span class="small ms-2">Sin imagen</span>
                            </div>
                        }
                    </div>
                    <div class="card-body d-flex flex-column">

                        <h5 class="card-title">@item.Objeto</h5>

                        <p class="card-text mb-1">
                            <strong>Precio Base:</strong> ₡@item.PrecioBase
                        </p>

                        <p class="card-text mb-1">
                            <strong>Pujas:</strong> @item.CantidadPujas
                        </p>

                        <p class="card-text text-danger">
                            <strong>Cierra:</strong> @item.FechaHoraCierre.ToString("f")
                        </p>
                        <!-- Acciones -->
                        <div class="card-footer bg-body border-0 pt-0 pb-3">
                            <div class="d-flex w-100 gap-2">

                                <!-- Ver detalle -->
                                <a asp-action="Details" asp-route-id="@item.IdSubasta"
                                   class="btn btn-primary w-100">
                                    Ver Detalles
                                </a>

                                @if (item.CantidadPujas == 0 && item.FechaHoraInicio > DateTime.Now)
                                {
                                    <!-- Editar -->
                                    <a asp-controller="Subastaa"
                                       asp-action="Edit"
                                       asp-route-id="@item.IdSubasta"
                                       class="btn btn-warning flex-fill d-flex align-items-center justify-content-center">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                }

                                <!-- Switch -->
                                @* @if (item.EstadoSubasta != "Activa" || item.FechaHoraInicio > DateTime.Now) *@
                                @if (item.FechaHoraInicio > DateTime.Now)
                                //!item.HistorialSubastas.Any(s => s.EstadoSubasta == "Activa") && !item.HistorialSubastas.Any(s => s.EstadoSubasta == "Finalizada"))
                                {
                                    <form asp-controller="Subastaa" asp-action="ToggleEstado" method="post" class="flex-fill d-flex justify-content-center align-items-center m-0">
                                        <input type="hidden" name="id" value="@item.IdSubasta" />

                                        <label class="switch m-0">
                                            <input type="checkbox"
                                                   onchange="confirmarCambio(this)"
                                                   @(item.EstadoSubasta == "Activa" ? "checked" : "")>
                                            <span class="slider"></span>
                                        </label>
                                    </form>
                                }

                            </div>
                        </div>
            @*             <div class="mt-auto">
                            <a asp-action="Details" asp-route-id="@item.IdSubasta"
                               class="btn btn-primary w-100">
                                Ver Detalles
                            </a>
                        </div> *@

                    </div>
                </div>
            </div>
        }

    </div>
</div>

@section Scripts {

    @if (TempData["Mensaje"] != null)
    {
        var mensaje = TempData["Mensaje"].ToString();

        <script>
            Swal.fire({
                icon: 'success',
                title: '@mensaje',
                showConfirmButton: false,
                timer: 2000
            });
        </script>
    }

    <style>
        .card-footer .btn {
            border-radius: 10px;
            height: 45px;
            font-size: 18px;
        }

        .card:hover {
            transform: translateY(-3px);
            transition: transform 0.18s ease;
        }

        .object-fit-cover {
            object-fit: cover;
        }

        /* 🔥 SWITCH BONITO */
        .switch {
            position: relative;
            display: inline-block;
            width: 55px;
            height: 30px;
        }

            .switch input {
                opacity: 0;
                width: 0;
                height: 0;
            }

        .slider {
            position: absolute;
            cursor: pointer;
            background-color: #ccc;
            border-radius: 34px;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            transition: 0.4s;
        }

            .slider:before {
                position: absolute;
                content: "";
                height: 22px;
                width: 22px;
                left: 4px;
                bottom: 4px;
                background-color: white;
                border-radius: 50%;
                transition: 0.4s;
            }

        input:checked + .slider {
            background-color: #198754; /* verde */
        }

            input:checked + .slider:before {
                transform: translateX(24px);
            }
    </style>

    <script>
        function confirmarCambio(elemento) {

            let activar = elemento.checked;

            Swal.fire({
                title: activar ? "¿Activar subasta?" : "¿Cancelar subasta?",
                text: activar
                    ? "La subasta estará disponible."
                    : "La subasta dejará de estar disponible.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Sí, continuar",
                cancelButtonText: "Cancelar"
            }).then((result) => {

                if (result.isConfirmed) {
                    elemento.form.submit();
                } else {
                    elemento.checked = !elemento.checked;
                }
            });
        }
    </script>

    <script>
                function renderSubastas(lista) {
            const contenedor = document.getElementById("contenedorSubastas");
            contenedor.innerHTML = "";

            lista.forEach(item => {

                const imagen = item.imagenPrincipal
                    ? `<img class="img-fluid"
                            style="max-height: 100%; max-width: 100%; object-fit: contain;"
                            src="data:image/jpeg;base64,${item.imagenPrincipal}" />`
                    : `<div class="d-flex justify-content-center align-items-center h-100 text-muted">
                            <i class="bi bi-image fs-1"></i>
                            <span class="small ms-2">Sin imagen</span>
                       </div>`;

                const puedeEditar = item.cantidadPujas == 0 &&
                                    new Date(item.fechaHoraInicio) > new Date();

                const puedeSwitch = new Date(item.fechaHoraInicio) > new Date();

                // botones dinámicos
                let botones = `
                    <a href="/Subastaa/Details/${item.idSubasta}"
                       class="btn btn-primary w-100">
                       Ver Detalles
                    </a>
                `;

                if (puedeEditar) {
                    botones += `
                        <a href="/Subastaa/Edit/${item.idSubasta}"
                           class="btn btn-warning d-flex align-items-center justify-content-center">
                           <i class="bi bi-pencil-square"></i>
                        </a>
                    `;
                }

                if (puedeSwitch) {
                    const checked = item.estadoSubasta === "Activa" ? "checked" : "";

                    botones += `
                        <form action="/Subastaa/ToggleEstado" method="post"
                              class="d-flex justify-content-center align-items-center m-0">

                            <input type="hidden" name="id" value="${item.idSubasta}" />

                            <label class="switch m-0">
                                <input type="checkbox" ${checked}
                                       onchange="confirmarCambio(this)">
                                <span class="slider"></span>
                            </label>
                        </form>
                    `;
                }

                const card = `
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm">

                            <div class="bg-light rounded-top d-flex justify-content-center align-items-center"
                                 style="height: 220px; overflow: hidden;">
                                ${imagen}
                            </div>

                            <div class="card-body d-flex flex-column">

                                <h5>${item.objeto}</h5>

                                <p><strong>Precio Base:</strong> ₡${item.precioBase}</p>
                                <p><strong>Pujas:</strong> ${item.cantidadPujas}</p>

                                <p class="text-danger">
                                    <strong>Cierra:</strong> ${new Date(item.fechaHoraCierre).toLocaleString()}
                                </p>

                                <div class="mt-auto d-flex gap-2">
                                    ${botones}
                                </div>

                            </div>
                        </div>
                    </div>
                `;

                contenedor.innerHTML += card;
            });
        }

        // Inicial
        renderSubastas(subastas);

        // Eventos
        document.getElementById("btnTodas").addEventListener("click", () => {
            renderSubastas(subastas);
        });

        document.getElementById("btnActivas").addEventListener("click", () => {
            const activas = subastas.filter(s => s.estadoSubasta === "Activa");
            renderSubastas(activas);
        });

        document.getElementById("btnFinalizadas").addEventListener("click", () => {
            const finalizadas = subastas.filter(s => s.estadoSubasta === "Finalizada");
            renderSubastas(finalizadas);
        });
    </script>
}
@model Subasta.Aplication.DTOs.SubastaDTO
@{
    ViewData["Title"] = "Proceso de Subasta";
}

<div class="container py-5">
    <!-- HEADER -->
    <div class="text-center mb-5">
        <h1 class="fw-bold display-5 mb-2">
            <i class="bi bi-hammer text-primary"></i>
            Subasta #@Model.IdSubasta
        </h1>
        <p id="estadoSubasta" class="text-muted fs-6">Participá en esta emocionante subasta</p>
    </div>
    
    <div class="row justify-content-center align-items-stretch g-4">
        <!-- IZQUIERDA: VENDEDOR -->
        <div class="col-lg-3">
            <div class="card h-100 shadow-sm border-0 rounded-4 p-4">
                <h6 class="fw-bold text-secondary mb-3 text-uppercase">
                    <i class="bi bi-person-fill me-2 text-primary"></i>Vendedor
                </h6>
                <div class="bg-light p-4 rounded-3">
                    <p class="fw-bold mb-1 fs-6">@Model.IdUsuarioCreadorNavigation.NombreCompleto</p>
                    <p class="text-muted mb-0 small">
                        <i class="bi bi-envelope me-1"></i>
                        @Model.IdUsuarioCreadorNavigation.CorreoElectronico
                    </p>
                </div>
            </div>
        </div>

        <!-- CENTRO: PRODUCTO -->
        <div class="col-lg-5">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <!-- CARRUSEL -->
                <div id="carouselExample" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        @for (int i = 0; i < Model.Imagenes.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Imagenes[i])"
                                     class="d-block w-100"
                                     style="height: 400px; object-fit: cover;"
                                     alt="Imagen del producto">
                            </div>
                        }
                    </div>
                    @if (Model.Imagenes.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                        </button>
                    }
                </div>

                <!-- INFO DEL PRODUCTO -->
                <div class="card-body p-4">
                    <h2 class="fw-bold mb-2">@Model.IdObjetoNavigation.Nombre</h2>
                    <div class="bg-light p-3 rounded-3 mb-4">
                        <p class="mb-0 text-secondary">@Model.IdObjetoNavigation.Descripcion</p>
                    </div>

                    <!-- CONTADOR -->
                    <div class="alert alert-warning d-flex align-items-center gap-2 mb-0">
                        <i class="bi bi-hourglass-split fs-5"></i>
                        <div>
                            <small class="d-block text-muted">Tiempo restante</small>
                            <div id="contador" class="fs-5 fw-bold"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- DERECHA: PANEL DE PUJAS -->
        <div class="col-lg-3">
            <div class="card h-100 shadow-sm border-0 rounded-4 p-4">
                <h5 class="fw-bold mb-4 text-success">
                    <i class="bi bi-cash-coin me-2"></i>Información de Pujas
                </h5>

                <ul class="list-group list-group-flush mb-4">
                    <li class="list-group-item d-flex justify-content-between px-0 py-3 border-bottom">
                        <span class="text-muted">Precio Base</span>
                        <strong>₡@Model.PrecioBase.ToString("N0")</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0 py-3 border-bottom">
                        <span class="text-muted">Incremento Mínimo</span>
                        <strong>₡@Model.IncrementoMinimo.ToString("N0")</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0 py-3 border-bottom">
                        <span class="text-muted">Puja Actual</span>
                        <strong class="text-success fs-5">
                            ₡<span id="pujaActual">@(Model.Pujas.Any() ? Model.Pujas.Max(p => p.MontoOfertado).ToString("N0") : "0")</span>
                        </strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0 py-3">
                        <span class="text-muted">Líder actual</span>
                        <strong id="usuarioLider" class="text-primary">
                            @(Model.Pujas.Any() ? Model.Pujas.OrderByDescending(p => p.MontoOfertado).First().NombreUsuario : "-")
                        </strong>
                    </li>
                </ul>

                <!-- ALERTA PUJA SUPERADA -->
                <div id="alertaSuperada" class="alert alert-danger d-none mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    ⚠️ ¡Tu puja ha sido superada!
                </div>

                <!-- ANUNCIO GANADOR -->
                <!-- ANUNCIO GANADOR -->
               
                @if (ViewBag.Resultado != null)
                {
                    <div class="alert alert-success mb-3">
                        🏆 <strong>Ganador:</strong> @ViewBag.Resultado.NombreUsuario <br />
                        💰 <strong>Monto final:</strong> ₡@ViewBag.Resultado.MontoFinal
                    </div>
                }
                else
                {
                    <div id="ganadorAnuncio" class="alert alert-success d-none mb-3" role="alert">
                    </div>
                }

                <!-- FORMULARIO -->
                <div id="seccionPuja">
                    <label class="form-label fw-bold small text-uppercase">Tu Puja</label>
                    <div class="input-group mb-2">
                        <span class="input-group-text bg-success text-white fw-bold">₡</span>
                        <input type="number"
                               id="montoPuja"
                               class="form-control form-control-lg"
                               placeholder="Ingresa tu oferta..."
                               min="@(Model.PrecioBase + Model.IncrementoMinimo)"
                               step="@Model.IncrementoMinimo" />
                    </div>
                    <small class="text-muted d-block mb-3">
                        Mínimo: ₡@((Model.PrecioBase + Model.IncrementoMinimo).ToString("N0"))
                    </small>
                    <button id="btnPujar" class="btn btn-success btn-lg w-100 fw-bold">
                        <i class="bi bi-hammer me-2"></i>Pujar Ahora
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- HISTORIAL DE PUJAS -->
    <div class="card mt-5 shadow-sm border-0 rounded-4">
        <div class="card-header bg-light border-0 rounded-top-4 p-4">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-clock-history text-primary me-2"></i>Historial de Pujas
            </h5>
        </div>
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Usuario</th>
                            <th>Monto</th>
                            <th>Fecha y Hora</th>
                        </tr>
                    </thead>
                    <tbody id="tablaHistorial"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <script>
        const idSubasta = @Model.IdSubasta;

        const precioBase = @Model.PrecioBase.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
        const incremento = @Model.IncrementoMinimo.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);

        const fechaFin = new Date('@Model.FechaHoraCierre.ToString("yyyy-MM-ddTHH:mm:ss")');

        let miUltimaPuja = 0;
    </script>

    <script>
        // ── CONTADOR ──────────────────────────────────────────
        function actualizarContador() {
            const diff = fechaFin - new Date();
            if (diff <= 0) {
                document.getElementById("contador").innerHTML =
                    '<span class="text-danger">Finalizada</span>';
                return;
            }

            const d = Math.floor(diff / 86400000);
            const h = Math.floor((diff / 3600000) % 24);
            const m = Math.floor((diff / 60000) % 60);
            const s = Math.floor((diff / 1000) % 60);

            document.getElementById("contador").innerHTML =
                d > 0 ? `${d}d ${h}h ${m}m` :
                h > 0 ? `${h}h ${m}m ${s}s` :
                `<span class="text-danger fw-bold">${m}m ${s}s</span>`;
        }

        setInterval(actualizarContador, 1000);
        actualizarContador();

        // ── SIGNALR ───────────────────────────────────────────
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/subastaHub")
            .withAutomaticReconnect()
            .build();

                connection.start().then(() => {
            connection.invoke("UnirseSubasta", idSubasta.toString());

            connection.invoke("ObtenerHistorial", idSubasta);
        });

        connection.on("NuevaPuja", function (data) {
            document.getElementById("pujaActual").innerText =
                parseFloat(data.montoLider).toLocaleString();

            document.getElementById("usuarioLider").innerText =
                data.usuarioLider;

            actualizarHistorial(data.historial);

            if (miUltimaPuja > 0 && data.montoLider > miUltimaPuja) {
                document.getElementById("alertaSuperada").classList.remove("d-none");
                setTimeout(() =>
                    document.getElementById("alertaSuperada").classList.add("d-none"), 5000);
            }
        });

                connection.on("PujaSuperada", function (mensaje) {
            alert(mensaje);
        });

                connection.on("SubastaFinalizada", function () {
            alert("La subasta ha finalizado");
            location.reload();
        });
        connection.on("SubastaCerrada", function (data) {
            document.getElementById("estadoSubasta").innerText = "Subasta Finalizada";
            document.getElementById("seccionPuja").style.display = "none";

            const ganador = document.getElementById("ganadorAnuncio");
            ganador.classList.remove("d-none");

            ganador.innerHTML = data.hayGanador
                ? `🏆 <strong>Ganador: ${data.ganador}</strong> con ₡${parseFloat(data.montoFinal).toLocaleString()}`
                : "Esta subasta finalizó sin ofertas.";
        });

                connection.on("HistorialInicial", function (pujas) {
            actualizarHistorial(pujas);
        });

        // ── HISTORIAL (FUNCION SEGURA) ─────────────────────────
        function actualizarHistorial(pujas) {
            const tbody = document.getElementById("tablaHistorial");

            if (!tbody) return;

            if (!pujas || pujas.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="3" class="text-center text-muted">
                            No hay pujas aún
                        </td>
                    </tr>`;
                return;
            }

            tbody.innerHTML = "";

            pujas.forEach(p => {
                const fecha = new Date(p.fechaHora).toLocaleString("es-CR");

                tbody.innerHTML += `
                    <tr>
                        <td><strong>${p.nombreUsuario}</strong></td>
                        <td class="fw-bold text-success">₡${parseFloat(p.montoOfertado).toLocaleString()}</td>
                        <td class="text-muted small">${fecha}</td>
                    </tr>`;
            });
        }

        // ── BOTÓN PUJAR ───────────────────────────────────────
        document.getElementById("btnPujar").addEventListener("click", async () => {

            const monto = parseFloat(document.getElementById("montoPuja").value);

            if (!monto || monto < (precioBase + incremento)) {
                alert(`La puja mínima es ₡${(precioBase + incremento).toLocaleString()}`);
                return;
            }

            const btn = document.getElementById("btnPujar");
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Procesando...';

            try {
                const response = await fetch("/Puja/RegistrarPuja", {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: `idSubasta=${idSubasta}&monto=${monto}`
                });

                const result = await response.json();

                if (result.exito) {
                    miUltimaPuja = monto;
                    document.getElementById("montoPuja").value = "";
                } else {
                    alert(result.mensaje);
                }

            } catch (err) {
                alert("Error de conexión: " + err.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-hammer me-2"></i>Pujar Ahora';
            }
        });

        

    </script>
}
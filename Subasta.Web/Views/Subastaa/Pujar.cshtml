@model Subasta.Aplication.DTOs.SubastaDTO

@{
    ViewData["Title"] = "Proceso de Subasta";
}

<div class="container py-5">

    <!-- HEADER -->
    <div class="text-center mb-5">
        <h1 class="fw-bold display-5 mb-2">
            <i class="bi bi-hammer text-primary"></i>
            Subasta #@Model.IdSubasta
        </h1>
        <p class="text-muted fs-6">Participá en esta emocionante subasta</p>
    </div>

    <div class="row justify-content-center align-items-stretch g-4">

        <!-- IZQUIERDA: VENDEDOR -->
        <div class="col-lg-3">
            <div class="card h-100 shadow-sm border-0 rounded-4 p-4 transition-all">

                <h6 class="fw-bold text-secondary mb-3 text-uppercase">
                    <i class="bi bi-person-fill me-2 text-primary"></i>
                    Vendedor
                </h6>

                <div class="bg-gradient p-4 rounded-3 border border-light">
                    <p class="fw-bold mb-1 fs-6">
                        @Model.IdUsuarioCreadorNavigation.NombreCompleto
                    </p>
                    <p class="text-muted mb-0 small">
                        <i class="bi bi-envelope me-1"></i>
                        @Model.IdUsuarioCreadorNavigation.CorreoElectronico
                    </p>
                </div>

                <!-- INFO ADICIONAL -->
                <div class="mt-4 pt-3 border-top">
                    <p class="small text-muted mb-2">
                        <i class="bi bi-shield-check me-1 text-success"></i>
                        Vendedor verificado
                    </p>
                    <p class="small text-muted">
                        <i class="bi bi-star-fill me-1 text-warning"></i>
                        Calificación: 4.8/5
                    </p>
                </div>

            </div>
        </div>

        <!-- CENTRO: PRODUCTO PROTAGONISTA -->
        <div class="col-lg-5">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

                <!-- CARRUSEL -->
                <div id="carouselExample" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner">

                        @for (int i = 0; i < Model.Imagenes.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@Model.Imagenes[i]"
                                     class="d-block w-100"
                                     style="height: 400px; object-fit: cover; background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);"
                                     alt="Imagen del producto">
                            </div>
                        }

                    </div>

                    @if (Model.Imagenes.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                        </button>
                    }
                </div>

                <!-- INFORMACIÓN DEL PRODUCTO -->
                <div class="card-body p-4">

                    <h2 class="fw-bold mb-2">
                        @Model.IdObjetoNavigation.Nombre
                    </h2>

                    <p class="text-muted small mb-4">
                        <span class="badge bg-info">Artículo único</span>
                    </p>

                    <div class="bg-light p-3 rounded-3 mb-4">
                        <p class="mb-0 text-secondary">
                            @Model.IdObjetoNavigation.Descripcion
                        </p>
                    </div>

                    <!-- VENDEDOR DEL OBJETO -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-secondary mb-2 text-uppercase">
                            <i class="bi bi-person me-1"></i> Propietario
                        </h6>
                        <div class="bg-light p-3 rounded-3">
                            <p class="fw-bold mb-1">
                                @Model.IdUsuarioCreadorNavigation.NombreCompleto
                            </p>
                            <p class="text-muted small mb-0">
                                @Model.IdObjetoNavigation.Vendedor
                            </p>
                        </div>
                    </div>

                    <!-- CONTADOR REGRESIVO -->
                    <div class="alert alert-warning d-flex align-items-center gap-2 mb-0">
                        <i class="bi bi-hourglass-split fs-5"></i>
                        <div>
                            <small class="d-block text-muted">Tiempo restante</small>
                            <div id="contador" class="fs-5 fw-bold"></div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- DERECHA: PANEL DE PUJAS -->
        <div class="col-lg-3">
            <div class="card h-100 shadow-sm border-0 rounded-4 p-4 sticky-top" style="top: 20px;">

                <h5 class="fw-bold mb-4 text-success">
                    <i class="bi bi-cash-coin me-2"></i> Información de Pujas
                </h5>

                <!-- LISTA DE VALORES -->
                <ul class="list-group list-group-flush mb-4">

                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3 border-bottom">
                        <span class="text-muted">Precio Base</span>
                        <strong class="fs-6">₡@Model.PrecioBase.ToString("N0")</strong>
                    </li>

                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3 border-bottom">
                        <span class="text-muted">Incremento Mínimo</span>
                        <strong class="fs-6">₡@Model.IncrementoMinimo.ToString("N0")</strong>
                    </li>

                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                        <span class="text-muted">Puja Actual</span>
                        <strong class="text-success fs-5">
                            ₡<span id="pujaActual">0</span>
                        </strong>
                    </li>

                </ul>

                <!-- FORMULARIO DE PUJA -->
                <form id="formPuja" class="mt-4">

                    <input type="hidden" id="idSubasta" value="@Model.IdSubasta" />

                    <div class="mb-3">
                        <label for="monto" class="form-label fw-bold small text-uppercase">
                            Tu Puja
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-success text-white fw-bold">₡</span>
                            <input type="number"
                                   id="monto"
                                   class="form-control form-control-lg"
                                   placeholder="Ingresa tu oferta..."
                                   min="@(Model.PrecioBase + Model.IncrementoMinimo)"
                                   step="@Model.IncrementoMinimo"
                                   required />
                        </div>
                        <small class="text-muted d-block mt-2">
                            Mínimo: ₡@(Model.PrecioBase + Model.IncrementoMinimo).ToString("N0")
                        </small>
                    </div>

                    <button type="submit" class="btn btn-success btn-lg w-100 fw-bold mb-3">
                        <i class="bi bi-hammer me-2"></i>
                        Pujar Ahora
                    </button>

                    <button type="button" class="btn btn-outline-primary w-100" onclick="favorito()">
                        <i class="bi bi-heart me-2"></i>
                        Agregar a Favoritos
                    </button>

                </form>

                <!-- INDICADOR DE ACTIVIDAD -->
                <div class="alert alert-info alert-sm mt-4 mb-0" role="alert">
                    <i class="bi bi-info-circle me-1"></i>
                    <small>Hay <strong id="pujaCount">0</strong> pujas activas</small>
                </div>

            </div>
        </div>

    </div>

    <!-- HISTORIAL DE PUJAS -->
    <div class="card mt-5 shadow-sm border-0 rounded-4">
        <div class="card-header bg-light border-0 rounded-top-4 p-4">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-clock-history text-primary me-2"></i>
                Historial de Pujas
            </h5>
        </div>

        <div class="card-body p-4">

            @if (Model.Pujas.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="fw-bold">Usuario</th>
                                <th class="fw-bold">Monto</th>
                                <th class="fw-bold">Fecha y Hora</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var puja in Model.Pujas.OrderByDescending(p => p.FechaHora).Take(10))
                            {
                                <tr class="transition-all">
                                    <td>
                                        <i class="bi bi-person-circle me-2 text-muted"></i>
                                        <strong>@puja.NombreUsuario</strong>
                                    </td>
                                    <td class="fw-bold text-success fs-6">
                                        ₡@puja.MontoOfertado.ToString("N0")
                                    </td>
                                    <td class="text-muted small">
                                        @puja.FechaHora.ToString("dd/MM/yyyy HH:mm:ss")
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0" role="alert">
                    <i class="bi bi-info-circle me-2"></i>
                    Aún no hay pujas. ¡Sé el primero en pujar!
                </div>
            }

        </div>
    </div>

</div>

<!-- ESTILOS PERSONALIZADOS -->
<style>
    :root {
        --primary-color: #0d6efd;
        --success-color: #198754;
        --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.08);
        --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.12);
    }

    .bg-gradient {
        background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
    }

    .transition-all {
        transition: all 0.3s ease;
    }

    .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md) !important;
        }

    .btn-success:hover {
        transform: scale(1.02);
        box-shadow: 0 4px 12px rgba(25, 135, 84, 0.3);
    }

    .carousel-control-prev,
    .carousel-control-next {
        background-color: rgba(0, 0, 0, 0.3);
        width: 40px;
        height: 40px;
        border-radius: 50%;
        top: 50%;
        transform: translateY(-50%);
    }

        .carousel-control-prev:hover,
        .carousel-control-next:hover {
            background-color: rgba(0, 0, 0, 0.5);
        }

    .table-responsive {
        border-radius: 0.375rem;
    }

    table tbody tr:hover {
        background-color: #f8f9fa;
    }

    .input-group-text {
        border: 1px solid #dee2e6;
    }

    .form-control:focus {
        border-color: var(--success-color);
        box-shadow: 0 0 0 0.2rem rgba(25, 135, 84, 0.25);
    }

    .sticky-top {
        z-index: 100;
    }

</style>

@section Scripts {
    <script>
        const fechaFin = new Date("@Model.FechaHoraCierre.ToString("yyyy-MM-ddTHH:mm:ss")");
        const pujaBase = @Model.PrecioBase;
        const incremento = @Model.IncrementoMinimo;

        function actualizarContador() {
            const ahora = new Date();
            const diferencia = fechaFin - ahora;

            if (diferencia <= 0) {
                document.getElementById("contador").innerHTML = '<span class="text-danger">Finalizada</span>';
                document.getElementById("formPuja").style.display = "none";
                return;
            }

            const dias = Math.floor(diferencia / (1000 * 60 * 60 * 24));
            const horas = Math.floor((diferencia / (1000 * 60 * 60)) % 24);
            const minutos = Math.floor((diferencia / (1000 * 60)) % 60);
            const segundos = Math.floor((diferencia / 1000) % 60);

            let texto = '';
            if (dias > 0) {
                texto = `${dias}d ${horas}h ${minutos}m`;
            } else if (horas > 0) {
                texto = `${horas}h ${minutos}m ${segundos}s`;
            } else {
                texto = `<span class="text-danger fw-bold">${minutos}m ${segundos}s</span>`;
            }

            document.getElementById("contador").innerHTML = texto;
        }

        setInterval(actualizarContador, 1000);
        actualizarContador();

        // Actualizar puja mínima en tiempo real
        document.getElementById("monto").addEventListener("input", function () {
            const valor = parseInt(this.value) || 0;
            this.min = pujaBase + incremento;
            if (valor < this.min) {
                this.classList.add("is-invalid");
            } else {
                this.classList.remove("is-invalid");
            }
        });
    </script>

    <script>
        document.getElementById("formPuja").addEventListener("submit", async function (e) {
            e.preventDefault();

            const idSubasta = document.getElementById("idSubasta").value;
            const monto = document.getElementById("monto").value;
            const btnPujar = this.querySelector("button[type='submit']");

            // Validación
            if (!monto || monto < (pujaBase + incremento)) {
                alert(`La puja mínima es ₡${(pujaBase + incremento).toLocaleString()}`);
                return;
            }

            // Desabilitar botón mientras se procesa
            btnPujar.disabled = true;
            btnPujar.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Procesando...';

            try {
                const response = await fetch("/Subasta/Pujar", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        idSubasta: idSubasta,
                        monto: parseInt(monto)
                    })
                });

                if (!response.ok) {
                    const error = await response.json();
                    alert(error.mensaje || "Error al procesar la puja");
                } else {
                    // Mostrar alerta de éxito
                    const Toast = new bootstrap.Toast(document.getElementById("successToast"));
                    Toast.show();

                    // Limpiar formulario
                    document.getElementById("monto").value = "";
                    document.getElementById("monto").classList.remove("is-invalid");

                    // Recargar historial (opcional - agregar AJAX)
                }
            } catch (error) {
                alert("Error de conexión: " + error.message);
            } finally {
                btnPujar.disabled = false;
                btnPujar.innerHTML = '<i class="bi bi-hammer me-2"></i>Pujar Ahora';
            }
        });

        function favorito() {
            alert("Funcionalidad de favoritos próximamente");
        }
    </script>

    <!-- Toast de éxito (agregado al final del body) -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="successToast" class="toast" role="alert">
            <div class="toast-header bg-success text-white">
                <i class="bi bi-check-circle me-2"></i>
                <strong class="me-auto">Éxito</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body">
                ¡Tu puja ha sido registrada correctamente!
            </div>
        </div>
    </div>
}
@model Subasta.Aplication.DTOs.SubastaDTO
@{
    ViewData["Title"] = "Proceso de Subasta";
}

<div class="container py-5">

    <!-- HEADER -->
    <div class="text-center mb-5">
        <h1 class="fw-bold display-5 mb-2">
            <i class="bi bi-hammer text-primary"></i>
            Subasta #@Model.IdSubasta
        </h1>
        <p id="estadoSubasta" class="text-muted fs-6">
            Participá en esta emocionante subasta
        </p>
    </div>
    <div id="ganadorAnuncio" class="alert alert-success text-center d-none mt-3"></div>
    <div class="row g-4">

        <!-- IZQUIERDA -->
        <div class="col-lg-3">
            <div class="card h-100 shadow-sm border-0 rounded-4 p-4">

                <!-- VENDEDOR SUBASTA -->
                <h6 class="fw-bold text-secondary text-uppercase mb-3">
                    <i class="bi bi-person-fill me-2 text-primary"></i>
                    Vendedor de la subasta
                </h6>
                <div class="bg-light p-3 rounded-3 mb-4">
                    <p class="fw-bold mb-1">@Model.IdUsuarioCreadorNavigation.NombreCompleto</p>
                    <p class="text-muted small mb-0">
                        <i class="bi bi-envelope me-1"></i>
                        @Model.IdUsuarioCreadorNavigation.CorreoElectronico
                    </p>
                </div>

                <!-- VENDEDOR OBJETO -->
                <h6 class="fw-bold text-secondary text-uppercase mb-3">
                    <i class="bi bi-person-badge me-2 text-primary"></i>
                    Vendedor del objeto
                </h6>
                <div class="bg-light p-3 rounded-3">
                    <p class="fw-bold mb-1">@Model.IdObjetoNavigation.IdUsuarioNavigation.NombreCompleto</p>
                    <p class="text-muted small mb-0">
                        @Model.IdObjetoNavigation.IdUsuarioNavigation.CorreoElectronico
                    </p>
                </div>

            </div>
        </div>

        <!-- CENTRO -->
        <div class="col-lg-6">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

                <!-- CARRUSEL -->
                <div id="carouselExample" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        @for (int i = 0; i < Model.Imagenes.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Imagenes[i])"
                                     class="d-block w-100"
                                     style="height: 400px; object-fit: cover;">
                            </div>
                        }
                    </div>

                    @if (Model.Imagenes.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                        </button>
                    }
                </div>

                <!-- INFO -->
                <div class="card-body p-4">
                    <h2 class="fw-bold mb-3">@Model.IdObjetoNavigation.Nombre</h2>

                    <!-- DESCRIPCIÓN -->
                    <div class="bg-light p-3 rounded-3 mb-4">
                        <h6 class="fw-bold text-secondary">Descripción</h6>
                        <p class="mb-0 text-muted">
                            @Model.IdObjetoNavigation.Descripcion
                        </p>
                    </div>

                    <!-- CONTADOR -->
                    <div class="alert alert-warning d-flex align-items-center gap-3 mb-0">
                        <i class="bi bi-hourglass-split fs-4"></i>
                        <div>
                            <small class="text-muted">Tiempo restante</small>
                            <div id="contador" class="fw-bold fs-5"></div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- DERECHA -->
        <div class="col-lg-3">
            <div class="card h-100 shadow-sm border-0 rounded-4 p-4">

                <h5 class="fw-bold text-success mb-4">
                    <i class="bi bi-cash-coin me-2"></i>
                    Información de Pujas
                </h5>

                <ul class="list-group list-group-flush mb-4">

                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Precio Base</span>
                        <strong>₡@Model.PrecioBase.ToString("N0")</strong>
                    </li>

                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Incremento</span>
                        <strong>₡@Model.IncrementoMinimo.ToString("N0")</strong>
                    </li>

                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Puja Actual</span>
                        <strong class="text-success fs-5">
                            <span id="pujaActual">
                                @(Model.Pujas.Any() ? Model.Pujas.Max(p => p.MontoOfertado).ToString("N0") : "0")
                            </span>
                        </strong>
                    </li>

                </ul>

                <!-- FORMULARIO -->
                <div id="seccionPuja">
                    <label class="form-label fw-bold small text-uppercase">
                        Tu Puja
                    </label>

                    <div class="input-group mb-2">
                        <span class="input-group-text bg-success text-white">₡</span>
                        <input type="number"
                               id="montoPuja"
                               class="form-control form-control-lg"
                               placeholder="Ingresa tu oferta..." />
                    </div>

                    <button id="btnPujar" class="btn btn-success w-100 fw-bold">
                        <i class="bi bi-hammer me-2"></i>Pujar Ahora
                    </button>
                </div>

            </div>
        </div>

    </div>

    <!-- HISTORIAL -->
    <div class="card mt-5 shadow-sm border-0 rounded-4">
        <div class="card-header bg-light p-4">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-clock-history text-primary me-2"></i>
                Historial de Pujas
            </h5>
        </div>

        <div class="card-body p-4">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Usuario</th>
                        <th>Monto</th>
                        <th>Fecha y Hora</th>
                    </tr>
                </thead>
                <tbody id="tablaHistorial"></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <script>
            // let pujaActualInicial = 
            /*@@(Model.Pujas.Any()*/
            // ? Model.Pujas.Max(p => p.MontoOfertado).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)
            // : "0");

    //             document.addEventListener("DOMContentLoaded", () => {
    //     document.getElementById("pujaActual").innerText =
    //         parseFloat(pujaActualInicial).toLocaleString();
    // });
        const idSubasta = @Model.IdSubasta;

        const precioBase = @Model.PrecioBase.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
        const incremento = @Model.IncrementoMinimo.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);

        const fechaFin = new Date('@Model.FechaHoraCierre.ToString("yyyy-MM-ddTHH:mm:ss")');

        let miUltimaPuja = 0;
    </script>

    <script>
        // ── CONTADOR ──────────────────────────────────────────
        function actualizarContador() {
            const diff = fechaFin - new Date();
            if (diff <= 0) {
                document.getElementById("contador").innerHTML =
                    '<span class="text-danger">Finalizada</span>';
                return;
            }

            const d = Math.floor(diff / 86400000);
            const h = Math.floor((diff / 3600000) % 24);
            const m = Math.floor((diff / 60000) % 60);
            const s = Math.floor((diff / 1000) % 60);

            document.getElementById("contador").innerHTML =
                d > 0 ? `${d}d ${h}h ${m}m` :
                h > 0 ? `${h}h ${m}m ${s}s` :
                `<span class="text-danger fw-bold">${m}m ${s}s</span>`;
        }

        setInterval(actualizarContador, 1000);
        actualizarContador();

        // ── SIGNALR ───────────────────────────────────────────
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/subastaHub")
            .withAutomaticReconnect()
            .build();

                connection.start().then(() => {
            connection.invoke("UnirseSubasta", idSubasta.toString());

            connection.invoke("ObtenerHistorial", idSubasta);

        });
        // --- Variables de rastreo en la parte superior ---
        let usuarioLiderActual = ""; // Para saber quién tiene la puja más alta en este momento
        let miUsuario = "@User.Identity.Name";

        connection.on("NuevaPuja", function (data) {
            const montoNuevo = parseFloat(data.montoLider);
            const nuevoUsuarioLider = data.usuarioLider;
            console.log("Entra: ", usuarioLiderActual + "Otro" + miUsuario + "Lider " + nuevoUsuarioLider);
            // 1. NOTIFICACIÓN: SI YO ERA EL LÍDER Y OTRO ME SUPERÓ
            if (usuarioLiderActual === miUsuario && nuevoUsuarioLider !== miUsuario) {
                console.log("Entra 2: ", usuarioLiderActual + "Otro" + miUsuario);
                Swal.fire({
                    icon: 'warning',
                    title: '¡Puja superada!',
                    text: 'Alguien ha superado tu oferta. ¡Puja de nuevo para recuperar el liderazgo!',
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 5000,
                    timerProgressBar: true
                });
            }

            // 2. NOTIFICACIÓN: SI YO SOY EL QUE ACABA DE PUJAR (Confirmación)
            if (nuevoUsuarioLider === miUsuario) {
                Swal.fire({
                    icon: 'success',
                    title: 'Puja realizada',
                    text: 'Tu oferta se ha registrado con éxito y eres el líder actual.',
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000
                });
            }
            // 3. NOTIFICACIÓN: NUEVA PUJA DE TERCEROS
            else if (usuarioLiderActual !== miUsuario) {
                // Solo mostrar "Nueva puja" si no me acaban de superar (para no saturar)
                Swal.fire({
                    icon: 'info',
                    title: 'Nueva puja',
                    text: `${nuevoUsuarioLider} ofertó ₡${montoNuevo.toLocaleString()}`,
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 2500
                });
            }

            // Actualizar estados globales y UI
            usuarioLiderActual = nuevoUsuarioLider;
            document.getElementById("pujaActual").innerText = montoNuevo.toLocaleString();
            actualizarHistorial(data.historial);
        });

        connection.on("PujaSuperada", function (mensaje) {
            Swal.fire({
                icon: 'warning',
                title: 'Puja superada',
                text: mensaje,
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true
            });
        });

        connection.on("SubastaFinalizada", function () {
            document.getElementById("estadoSubasta").innerText = "Subasta Finalizada";
            document.getElementById("seccionPuja").style.display = "none";

            Swal.fire({
                icon: 'success',
                title: 'Subasta finalizada',
                text: 'La subasta ha terminado.',
                confirmButtonText: 'Entendido'
            });

        });

        connection.on("SubastaCerrada", function (data) {
            document.getElementById("estadoSubasta").innerText = "Subasta Finalizada";
            document.getElementById("seccionPuja").style.display = "none";

            Swal.fire({
                icon: data?.hayGanador ? 'success' : 'info',
                title: data?.hayGanador ? 'Subasta finalizada 🏆' : 'Subasta finalizada',
                html: data?.hayGanador
                    ? `<b>${data.ganador}</b> ganó con ₡${parseFloat(data.montoFinal).toLocaleString()}`
                    : 'La subasta ha terminado.',
                confirmButtonText: 'Entendido'
            });
        });

                connection.on("HistorialInicial", function (pujas) {
            actualizarHistorial(pujas);
        });

        // ── HISTORIAL (FUNCION SEGURA) ─────────────────────────
                function actualizarHistorial(pujas) {
            const tbody = document.getElementById("tablaHistorial");
            const pujaActualElem = document.getElementById("pujaActual");

            if (!tbody) return;

            if (!pujas || pujas.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="3" class="text-center text-muted">
                            No hay pujas aún
                        </td>
                    </tr>`;

                if (pujaActualElem) {
                    pujaActualElem.textContent = "₡0";
                }   

                return;
            }

            tbody.innerHTML = "";

            let pujaMasAlta = 0;

            pujas.forEach(p => {
                const fecha = new Date(p.fechaHora).toLocaleString("es-CR");
                const monto = parseFloat(p.montoOfertado);

                // Detectar la puja más alta
                if (monto > pujaMasAlta) {
                    pujaMasAlta = monto;
                }

                tbody.innerHTML += `
                    <tr>
                        <td><strong>${p.nombreUsuario}</strong></td>
                        <td class="fw-bold text-success">₡${monto.toLocaleString()}</td>
                        <td class="text-muted small">${fecha}</td>
                    </tr>`;
            });

            // 🔥 Actualizar la puja actual en la UI
            if (pujaActualElem) {
                pujaActualElem.textContent = `₡${pujaMasAlta.toLocaleString()}`;
            }

             miUltimaPuja = pujaMasAlta;
        }

        // ── BOTÓN PUJAR ───────────────────────────────────────
        document.getElementById("btnPujar").addEventListener("click", async () => {

            const monto = parseFloat(document.getElementById("montoPuja").value);

                    const pujaActual = parseFloat(
            document.getElementById("pujaActual").innerText.replace(/,/g, "")
        );

        if (!monto || monto < (pujaActual + incremento)) {
            Swal.fire({
                icon: 'warning',
                title: 'Puja inválida',
                text: `Debes ofertar al menos ₡${(pujaActual + incremento).toLocaleString()}`
            });
            return;
        }

            const btn = document.getElementById("btnPujar");
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Procesando...';

            try {
                const response = await fetch("/Puja/RegistrarPuja", {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: `idSubasta=${idSubasta}&monto=${monto}`
                });

                const result = await response.json();

                if (result.exito) {
                    miUltimaPuja = monto;
                    document.getElementById("montoPuja").value = "";
                } else {
                            Swal.fire({
            icon: 'error',
            title: 'Error',
            text: result.mensaje
        });
                }
            } catch (err) {
                        Swal.fire({
            icon: 'error',
            title: 'Error de conexión',
            text: err.message
        });
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-hammer me-2"></i>Pujar Ahora';
            }
        });

        

    </script>
}
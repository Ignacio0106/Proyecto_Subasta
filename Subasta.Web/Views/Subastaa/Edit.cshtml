@model Subasta.Aplication.DTOs.SubastaDTO

@{
    ViewData["Title"] = "Editar Subasta";
    bool bloqueada = Model.CantidadPujas > 0;
}

<h1 class="mb-4">Editar Subasta #@Model.IdSubasta</h1>

<div class="row">
    <!-- 🔹 INFO OBJETO -->
    <div class="col-md-5">
        <div class="card mb-3">
            <div class="card-header bg-dark text-white fw-semibold">
                Objeto
            </div>
            <div class="card-body text-center">
                <h5 class="mb-3">@Model.Objeto</h5>

                @if (Model.Imagenes != null && Model.Imagenes.Any())
                {
                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Imagenes.First())"
                         class="img-fluid rounded shadow-sm"
                         style="max-height:250px; object-fit:contain;" />
                }
                else
                {
                    <div class="bg-light p-4 text-muted rounded">
                        Sin imagen
                    </div>
                }

                <div class="p-3">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <span class="fw-bold">Estado del objeto</span>
                        <span class="badge rounded-pill bg-primary px-3 shadow-sm">@Model.Condicion</span>
                    </div>
                </div>
                <div class="d-flex align-items-center mb-3">
                    <div class="me-3">
                        <span class="fw-bold">Categorías</span>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        @if (Model.Categorias != null && Model.Categorias.Any())
                        {
                            foreach (var cat in Model.Categorias)
                            {
                                <span class="badge border-1 border-info text-primary bg-light px-3 py-2 rounded-pill shadow-sm">@cat</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Sin categorías</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 🔹 FORM -->
    <div class="col-md-7">
        <div class="card mb-3">
            <div class="card-header bg-dark text-white fw-semibold">
                Editar Datos
            </div>
            <div class="card-body">

                @if (bloqueada)
                {
                    <div class="alert alert-danger">
                        ❌ Esta subasta no se puede editar porque ya inició o tiene pujas.
                    </div>
                }

                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="IdSubasta" />

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Fecha inicio</label>
                            <input asp-for="FechaHoraInicio"
                                   type="datetime-local"
                                   class="form-control"
                                   disabled="@(bloqueada)" id="fechaInicio" />
                            <span asp-validation-for="FechaHoraInicio" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Fecha cierre</label>
                            <input asp-for="FechaHoraCierre"
                                   type="datetime-local"
                                   class="form-control"
                                   disabled="@(bloqueada)" id="fechaCierre" />
                            <span asp-validation-for="FechaHoraCierre" class="text-danger"></span>
                        </div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Precio base</label>
                            <div class="input-group">
                                <input asp-for="PrecioBase"
                                       class="form-control"
                                       disabled="@(bloqueada)" />
                            </div>
                            <span asp-validation-for="PrecioBase" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Incremento mínimo</label>
                            <div class="input-group">
                                <input asp-for="IncrementoMinimo"
                                       class="form-control"
                                       disabled="@(bloqueada)" />
                            </div>
                            <span asp-validation-for="IncrementoMinimo" class="text-danger"></span>
                        </div>
                    </div>

                    <hr />

                    <!-- INFO SOLO LECTURA -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <small>Estado</small>
                            <div>
                                @{
                                    var estadoClass = Model.EstadoSubasta == "Activa"
                                    ? "bg-success"
                                    : "bg-secondary";
                                }
                                <span class="badge @estadoClass px-3 py-2">
                                    @Model.EstadoSubasta
                                </span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <small>Pujas</small>
                            <div class="fw-bold">
                                @Model.CantidadPujas
                            </div>
                        </div>
                    </div>

                    @if (!bloqueada)
                    {
                        <button type="submit" class="btn btn-success">
                            Guardar cambios
                        </button>
                    }

                    <a asp-action="Index" class="btn btn-outline-dark ms-2">
                        Volver
                    </a>
                </form>

            </div>
        </div>
    </div>
</div>

                        
@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        const fechaInicio = document.getElementById("fechaInicio");
        const fechaCierre = document.getElementById("fechaCierre");

        fechaInicio.addEventListener("change", function () {
            fechaCierre.min = this.value;
        });
    </script>
}
@model Subasta.Web.ViewModels.ViewModelLogin
@{
    Layout = null;
    ViewData["Title"] = "Iniciar sesión";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Subasta</title>

    @* Bootstrap 5.3.8*@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <!-- SweetAlert2 (LibMan) -->
    <link rel="stylesheet" href="~/lib/sweetalert2/dist/sweetalert2.min.css" />


    @* Estilos propios*@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Subasta.Web.styles.css" asp-append-version="true" />
</head>

<body class="bg-light">

    <div class="container min-vh-100 d-flex align-items-center justify-content-center">

        <div class="col-12 col-sm-10 col-md-6 col-lg-4">

            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

                <!-- HEADER -->
                <div class="card-header bg-dark text-white text-center py-4">
                    <i class="bi bi-person-circle display-5 mb-2"></i>
                    <h3 class="fw-semibold mb-1">Bienvenido</h3>
                    <small class="text-light">Ingrese sus credenciales para acceder al sistema</small>
                </div>

                <!-- BODY -->
                <div class="card-body p-4">

                    <form id="loginForm" asp-controller="Login" asp-action="LogIn" method="post">

                        <!-- USER -->
                        <div class="mb-3">
                            <label asp-for="User" class="form-label fw-semibold"></label>

                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-white">
                                    <i class="bi bi-person-fill text-primary"></i>
                                </span>

                                <input asp-for="User"
                                       class="form-control border-start-0"
                                       placeholder="Ingrese su usuario" />
                            </div>

                            <span asp-validation-for="User" class="text-danger small"></span>
                        </div>

                        <!-- PASSWORD -->
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold"></label>

                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-white">
                                    <i class="bi bi-lock-fill text-primary"></i>
                                </span>

                                <input asp-for="Password"
                                       id="Password"
                                       type="password"
                                       class="form-control border-start-0"
                                       placeholder="Ingrese su contraseña" />

                                <button class="btn btn-outline-secondary"
                                        type="button"
                                        id="togglePassword">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>

                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- ERROR -->
                        @if (ViewBag.Message != null)
                        {
                            <div class="alert alert-danger mt-3 shadow-sm">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                @ViewBag.Message
                            </div>
                        }

                        <!-- BUTTON -->
                        <div class="d-grid mt-4">
                            <button id="btnLogin" class="btn btn-primary btn-lg shadow-sm">
                                <span id="btnText">
                                    <i class="bi bi-box-arrow-in-right me-2"></i>
                                    Iniciar sesión
                                </span>

                                <span id="btnSpinner" class="d-none">
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    Validando...
                                </span>
                            </button>
                        </div>

                        <div class="text-center mt-3">
                            <small class="text-muted">
                                Verifique sus credenciales
                            </small>
                        </div>

                    </form>
                </div>

                <!-- FOOTER -->
                <div class="card-footer text-center bg-light border-0 py-3">
                    <small class="text-muted">Sistema de Subastas</small>
                </div>

            </div>

        </div>
    </div>
    <style>
        /* Ocultar el icono de revelar contraseña nativo en Edge y Chrome */
        input::-ms-reveal,
        input::-ms-clear {
            display: none;
        }
    </style>
    <!-- Scripts (orden recomendado) -->
    <!-- jQuery (es necesario para jQuery UI / multiselect / unobtrusive) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- Bootstrap JS 5.3.8 (no requiere jQuery) -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- SweetAlert -->
    <script src="~/lib/sweetalert2/dist/sweetalert2.all.js"></script>


    <script>
        document.getElementById("loginForm").addEventListener("submit", function () {
            const btn = document.getElementById("btnLogin");
            const btnText = document.getElementById("btnText");
            const btnSpinner = document.getElementById("btnSpinner");

            btn.disabled = true;
            btnText.classList.add("d-none");
            btnSpinner.classList.remove("d-none");
        });

        document.getElementById("togglePassword").addEventListener("click", function () {
            const input = document.getElementById("Password");
            const icon = this.querySelector("i");

            if (input.type === "password") {
                input.type = "text";
                icon.classList.replace("bi-eye", "bi-eye-slash");
            } else {
                input.type = "password";
                icon.classList.replace("bi-eye-slash", "bi-eye");
            }
        });
    </script>

    @if (TempData["Notificacion"] != null || ViewBag.Notificacion != null)
    {
        var notificacion = TempData["Notificacion"] ?? ViewBag.Notificacion;
        <script type="text/javascript">

            const payload = @Html.Raw(notificacion);

            if (payload) {
                Swal.fire(payload);
            }
        </script>
    }
</body>
</html>
@{
    Layout = null;
    ViewData["Title"] = "Acceso denegado";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Subasta</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <!-- SweetAlert -->
    <link rel="stylesheet" href="~/lib/sweetalert2/dist/sweetalert2.min.css" />

    <!-- Estilos -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Subasta.Web.styles.css" asp-append-version="true" />
</head>

<body class="bg-light">

    <div class="container min-vh-100 d-flex align-items-center justify-content-center">

        <div class="col-12 col-sm-10 col-md-6 col-lg-4">

            <div class="card shadow-lg border-0 rounded-4 overflow-hidden text-center">

                <!-- HEADER -->
                <div class="card-header bg-dark text-white py-4">
                    <i class="bi bi-shield-lock-fill display-5 text-warning mb-2"></i>
                    <h3 class="fw-semibold mb-1">Acceso denegado</h3>
                    <small class="text-light">
                        No tiene permisos para acceder
                    </small>
                </div>

                <!-- BODY -->
                <div class="card-body p-4">

                    <div class="alert alert-warning d-flex align-items-start text-start shadow-sm">
                        <i class="bi bi-exclamation-triangle-fill me-3 fs-5"></i>
                        <div>
                            <strong>Acción restringida</strong><br />
                            Su cuenta no cuenta con autorización para este recurso.
                        </div>
                    </div>

                    <p class="text-muted mt-3">
                        Puede regresar, ir al inicio o cerrar sesión para cambiar de usuario.
                    </p>

                    <!-- BOTONES -->
                    <div class="d-grid gap-2 mt-4">

                        <a href="javascript:history.back()" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left-circle me-2"></i>
                            Regresar
                        </a>

                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary shadow-sm">
                            <i class="bi bi-house-door-fill me-2"></i>
                            Ir al inicio
                        </a>

                        <a asp-controller="Login" asp-action="LogOff" class="btn btn-danger shadow-sm">
                            <i class="bi bi-box-arrow-right me-2"></i>
                            Cerrar sesión
                        </a>

                    </div>

                </div>

                <!-- FOOTER -->
                <div class="card-footer bg-light border-0 py-3">
                    <small class="text-muted">Sistema de Subastas</small>
                </div>

            </div>

        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/dist/sweetalert2.all.js"></script>

    @if (TempData["Notificacion"] != null || ViewBag.Notificacion != null)
    {
        var notificacion = TempData["Notificacion"] ?? ViewBag.Notificacion;
        <script>
            const payload = @Html.Raw(notificacion);
            if (payload) {
                Swal.fire(payload);
            }
        </script>
    }

</body>
</html>